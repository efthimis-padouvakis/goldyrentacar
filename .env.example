# Karpadu backend (same API as CarRentalNext)
KARPADU_BACKEND=https://api.karpadu.com
SUB_KEY=

# Channel sent to GetAvailability / MakeReservation
KARPADU_CHANNEL=karpadu

# Comma-separated companyId list to keep in availability, e.g. GOLDY_COMPANY_IDS=49
# Empty = show every supplier
GOLDY_COMPANY_IDS=1

# false = booking form hands off to WhatsApp / email
# true  = customer pays the full total with Viva Wallet, then the payment webhook calls MakeReservation
# RESERVATIONS_ENABLED=false
RESERVATIONS_ENABLED=true
# Viva Wallet (Smart Checkout). demo = sandbox, live = real payments
VIVA_ENV=demo
# Settings > API Access > Smart Checkout credentials
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
# 4-digit code of the payment source (Sales > Online payments > Websites/apps)
VIVA_SOURCE_CODE=
# Settings > API Access > Merchant ID and API Key (webhook verification and refunds)
VIVA_MERCHANT_ID=
VIVA_API_KEY=
